# Unikaj znaku $ w wartosciach (docker compose traktuje go jako zmienna).
# DB_PASSWORD jest ustawiane tylko przy pierwszym starcie bazy; pozniejsza zmiana wymaga zmiany hasla w PostgreSQL.
# Kanał obrazu Dockera: stable (domyślnie) albo beta (wersje testowe)
APP_CHANNEL=stable
DB_PASSWORD=zmien_to_haslo
ADMIN_USER=admin
ADMIN_PASSWORD=zmien_to_haslo
SECRET_KEY=wygeneruj_dlugi_losowy_ciag
RETENTION_DAYS=30
# Pomiary interfejsów to największa tabela w bazie: ile dni je trzymać (mniej = mniejsza baza)
IFACE_RETENTION_DAYS=7
# Porty panelu na serwerze (gdy 80/443 zajmuje inna usługa). Certyfikat Let's Encrypt wymaga dostępu z internetu na 80 i 443.
HTTP_PORT=80
HTTPS_PORT=443
# Logi z routerów (syslog UDP): port na serwerze i czas przechowywania
SYSLOG_PORT=514
LOG_RETENTION_DAYS=14
# Kopie zapasowe bazy: godzina (czas lokalny wg TZ) i liczba dni przechowywania
TZ=Europe/Warsaw
BACKUP_HOUR=3
BACKUP_KEEP_DAYS=14
# 1 = dołącz do kopii historię pomiarów (wykresy); domyślnie 0 = kopia mała, z logami, bez wykresów
BACKUP_INCLUDE_METRICS=0
# Test prędkości (tylko routery brzegowe): godzina na routerze, plik testowy i jego rozmiar w bajtach
SPEEDTEST_TIME=03:30:00
# Silnik i serwer testu wybierasz w Ustawieniach (domyślnie Speedtest by Ookla, wbudowany w kontener)
SPEEDTEST_URL=https://speed.cloudflare.com/__down?bytes=25000000
SPEEDTEST_BYTES=25000000
# Test prędkości z serwera aplikacji (Ustawienia -> Test prędkości): liczba równoległych połączeń
SPEEDTEST_STREAMS=6
